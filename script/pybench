#!/usr/bin/env bash

set -eou pipefail

uv run --no-sync --with pytest-benchmark --with pytest-random-order pytest \
    --verbose \
    --benchmark-min-time=1 \
    --benchmark-max-time=5 \
    --benchmark-disable-gc \
    --benchmark-autosave \
    --benchmark-save-data \
    --random-order \
    "bench/benchmark_$1.py"
