#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
uv sync --locked --no-install-project --group native --group integration
mkdir -p .artifacts
build_dir=$(mktemp -d "$PWD/.artifacts/debug-wheel.XXXXXX")
build_python=$(uv run --no-sync python -c 'import sys; print(sys.executable)')
uv build --wheel --no-sources --python "$build_python" -C 'maturin.build-args=--locked --profile dev' --out-dir "$build_dir"
uv pip install --python "$build_python" --no-deps --reinstall "$build_dir"/*.whl
uv run --no-sync python -m pytest -v test compatibility integration_pydantic
